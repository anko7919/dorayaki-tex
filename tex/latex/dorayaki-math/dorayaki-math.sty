% 数学系マクロ関係
\ProvidesPackage{dorayaki-math}[2026/05/02 dorayaki-math]

\RequirePackage{mathtools}
\RequirePackage{unicode-math}

% ----------- Main -----------

\mathtoolsset{showonlyrefs=true}

% Operators
\DeclareMathOperator{\Spec}{Spec}
\DeclareMathOperator{\Gal}{Gal}
\DeclareMathOperator{\Aut}{Aut}
\DeclareMathOperator{\End}{End}
\DeclareMathOperator{\Hom}{Hom}
\DeclareMathOperator{\ord}{ord}

% Delimiters
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiter{\set}{\lbrace}{\rbrace}
\DeclarePairedDelimiter{\floor}{\lfloor}{\rfloor}
\DeclarePairedDelimiter{\ceil}{\lceil}{\rceil}
\DeclarePairedDelimiterX{\dlegendre}[2]{\lparen}{\rparen}{\dfrac{#1}{#2}}
\DeclarePairedDelimiterX{\tlegendre}[2]{\lparen}{\rparen}{#1 / #2}

% Sets
\NewDocumentCommand{\ZZ}{}{\symbb{Z}}
\NewDocumentCommand{\QQ}{}{\symbb{Q}}
\NewDocumentCommand{\RR}{}{\symbb{R}}
\NewDocumentCommand{\CC}{}{\symbb{C}}
\NewDocumentCommand{\FF}{}{\symbb{F}}

