\NeedsTeXFormat{LaTeX2e}[2025-06-01]
\ProvidesPackage{dorayaki-thm}[2026/05/03 dorayaki-thm]

\RequirePackage{kvoptions}
\RequirePackage{etoolbox}
\RequirePackage{amsthm}

% ======= Options =======
\SetupKeyvalOptions{
  family=dorayaki,
  prefix=dorayaki@
}

\DeclareStringOption{language}

\ProcessKeyvalOptions*

% ======= Main =======
% ----- 定理環境 -----
% 言語別見出し定義
\newcommand{\thm@english}{Theorem}
\newcommand{\lem@english}{Lemma}
\newcommand{\cor@english}{Corollary}
\newcommand{\prop@english}{Proposition}
\newcommand{\dfn@english}{Definition}
\newcommand{\rem@english}{Remark}
\newcommand{\thm@japanese}{定理}
\newcommand{\lem@japanese}{補題}
\newcommand{\cor@japanese}{系}
\newcommand{\prop@japanese}{命題}
\newcommand{\dfn@japanese}{定義}
\newcommand{\rem@japanese}{注}

% 言語と種類に対しコマンドを割り当てる
\newcommand{\theorem@type@lang}[2]{%
  \@ifundefined{#1@#2}{%
    \PackageError{dorayaki-math}{unknown language: #2}{}
  }{%
    \csname #1@#2\endcsname
  }%
}

% 日本語
\newtheoremstyle{japanese-thm}%
    {3pt}% 上部スペース
    {3pt}% 下部スペース
    {\normalfont}% 本文フォント
    {0pt}% 1行目のインデント量
    {\bfseries}% 見出しフォント
    {.}% 見出し後の句読点
    { }% 見出し後のスペース
    {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}
\newtheoremstyle{japanese-dfn}%
    {3pt}%
    {3pt}%
    {\normalfont}%
    {0pt}%
    {\bfseries}%
    {.}%
    { }%
    {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

% 英語
\newtheoremstyle{english-thm}%
    {3pt}%
    {3pt}%
    {\itshape}%
    {0pt}%
    {\bfseries}%
    {.}%
    { }%
    {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}
\newtheoremstyle{english-dfn}%
    {3pt}%
    {3pt}%
    {\normalfont}%
    {0pt}%
    {\bfseries}%
    {.}%
    { }%
    {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

\theoremstyle{\dorayaki@language-thm}
\newtheorem{thm}{\theorem@type@lang{thm}{\dorayaki@language}}
\newtheorem{lem}[thm]{\theorem@type@lang{lem}{\dorayaki@language}}
\newtheorem{cor}[thm]{\theorem@type@lang{cor}{\dorayaki@language}}
\newtheorem{prop}[thm]{\theorem@type@lang{prop}{\dorayaki@language}}
\newtheorem*{thm*}{\theorem@type@lang{thm}{\dorayaki@language}}
\newtheorem*{lem*}{\theorem@type@lang{lem}{\dorayaki@language}}
\newtheorem*{cor*}{\theorem@type@lang{cor}{\dorayaki@language}}
\newtheorem*{prop*}{\theorem@type@lang{prop}{\dorayaki@language}}
\theoremstyle{\dorayaki@language-dfn}
\newtheorem*{dfn*}{\theorem@type@lang{dfn}{\dorayaki@language}}
\newtheorem*{rem*}{\theorem@type@lang{rem}{\dorayaki@language}}

% ----- 証明環境 -----
\ifdefstring{\dorayaki@language}{japanese}{%
  \renewenvironment{proof}[1][\proofname]{\par
    \pushQED{\qed}%
    \normalfont \topsep6\p@\@plus6\p@\relax
    \trivlist
    \item\relax
    {%\bfseries
    #1\@addpunct{. }}\hspace\labelsep\ignorespaces
  }{%
    \popQED\endtrivlist\@endpefalse
  }
}{}

