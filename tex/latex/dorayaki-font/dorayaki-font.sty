% フォントの設定関係
\ProvidesPackage{dorayaki-font}[2026/05/02 dorayaki-font]

\RequirePackage{fontspec}
\RequirePackage{luatexja-fontspec}
\RequirePackage{mathtools}
\RequirePackage{unicode-math}

\newif\ifposter
\posterfalse

\DeclareOption{poster}{\postertrue}
\DeclareOption{paper}{\posterfalse}

\DeclareOption*{%
  \PassOptionsToPackage{\CurrentOption}{fontspec}%
  \PassOptionsToPackage{\CurrentOption}{unicode-math}%
}

\ProcessOptions\relax

% ------ フォント設定 ------
\ifposter
  % Poster (sans)
  \setmainfont{Noto Sans}
  \setmathfont{Libertinus Math}
  \setmainjfont{Noto Sans CJK JP}
\else
  % Paper (serif)
  \setmainfont{Libertinus Serif}
  \setsansfont{Libertinus Sans}
  \setsansfont{Libertinus Mono}
  \setmathfont{Libertinus Math}
  \setmainjfont{Noto Serif CJK JP}
\fi

