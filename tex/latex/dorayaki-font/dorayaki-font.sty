\NeedsTeXFormat{LaTeX2e}[2025-06-01]
\ProvidesPackage{dorayaki-font}[2026/05/02 The font package]

\RequirePackage{fontspec}
\RequirePackage{luatexja-fontspec}
\RequirePackage{unicode-math}

\DeclareKeys[dorayaki-font]{%
  sans.if = @dorayaki@sans,
  serif.ifnot = @dorayaki@sans,
  mathfontscale.store = \dorayaki@mathfontscale,
  jafontscale.store = \dorayaki@jafontscale,
}

\DeclareUnknownKeyHandler{%
  \PassOptionsToPackage{\CurrentOption}{unicode-math}
}

\ProcessKeyOptions

\if@dorayaki@sans
  \setmathfont[Scale=\dorayaki@mathfontscale]{STIX Two Math}
  \setmainfont{Noto Sans}
  \setmainjfont[Scale=\dorayaki@jafontscale]{Noto Sans CJK JP}
\else
  \setmainfont{Libertinus Serif}
  \setsansfont{Libertinus Sans}
  \setmonofont{Libertinus Mono}
  \setmathfont[Scale=\dorayaki@mathfontscale]{Libertinus Math}
  \setmainjfont[Scale=\dorayaki@jafontscale]{Noto Serif CJK JP}
\fi

