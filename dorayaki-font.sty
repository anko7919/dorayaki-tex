\NeedsTeXFormat{LaTeX2e}[2025-06-01]
\ProvidesPackage{dorayaki-font}[2026/05/02 The font package]

\DeclareKeys[dorayaki-font]{%
  sans.if = @dorayaki@sans,
  serif.ifnot = @dorayaki@sans,
  jpn.if = @dorayaki@jpn,
}

\DeclareUnknownKeyHandler{%
  \PassOptionsToPackage{\CurrentOption}{unicode-math}
}

\ProcessKeyOptions

\if@dorayaki@jpn
  \PackageInfo{ dorayaki-font }{ japanese }
  \RequirePackage{luatexja-fontspec}
  \RequirePackage{luatexja-adjust}
\fi
\RequirePackage{fontspec}
\RequirePackage{unicode-math}

\if@dorayaki@sans
  \PackageInfo{ dorayaki-font }{ sans mode }
  \setmathfont{STIX Two Math}
  \setmainfont{Noto Sans}
  \if@dorayaki@jpn
    \setmainjfont{Noto Sans CJK JP}
  \fi
\else
  \PackageInfo{ dorayaki-font }{ serif mode }
  \setmainfont{Libertinus Serif}
  \setsansfont{Libertinus Sans}
  \setmonofont{Libertinus Mono}
  \setmathfont{Libertinus Math}
  \if@dorayaki@jpn
    \setmainjfont{HaranoAjiMincho}
    \setsansjfont{HaranoAjiGothic}
    \setmathfont{Libertinus Math}
    \setmainfont{STIX Two Text}
    \setsansfont{STIX Two Text}
    \setmonofont{STIX Two Text}
  \fi
\fi

