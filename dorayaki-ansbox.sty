\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dorayaki-ansbox}[2026/09/27]

\RequirePackage{refcount}

\newcounter{dorayakianswer}

\ExplSyntaxOn

\seq_new:N \g__dorayaki_ans_seq
\prop_new:N \g__dorayaki_num_prop
\int_new:N \g__dorayaki_counter_int

\cs_new:Nn \__dorayaki_ansbox:n {
  \framebox[3em]{#1}
}

\NewDocumentCommand{\ans}{ o m }{
  \refstepcounter{dorayakianswer}
  \int_gadd:Nn \g__dorayaki_counter_int { 1 }
  \label{dorayaki:ans:\int_use:N\g__dorayaki_counter_int}
  \IfValueT{#1}{
    \prop_gput:NnV \g__dorayaki_num_prop { #1 } \g__dorayaki_counter_int
  }
  \prop_log:N \g__dorayaki_num_prop
  \__dorayaki_ansbox:n{\thedorayakianswer}
  \seq_gput_right:Nn \g__dorayaki_ans_seq { #2 }
}

\NewDocumentCommand{\refans}{ m }{
  \prop_get:NnN \g__dorayaki_num_prop { #1 } \l_tmpa_tl
  \tl_log:N \l_tmpa_tl
  \__dorayaki_ansbox:n{ \ref{ dorayaki:ans:\tl_use:N\l_tmpa_tl } }
}

\NewDocumentCommand{\printans}{}{
  \seq_map_indexed_inline:Nn \g__dorayaki_ans_seq {
    \tl_set:Nx \l_tmpa_tl { \getpagerefnumber{dorayaki:ans:##1} }
    \int_compare:nNnTF { ##1 } = { 1 } {
      \noindent\textsf{Answers}\par
    } {
      \tl_if_eq:NNF \g_tmpa_tl \l_tmpa_tl {
        \newpage
        \noindent\textsf{Answers}\par
      }
    }
    \noindent ##1.~##2 \par
    \tl_gset:NV \g_tmpa_tl \l_tmpa_tl
  }
}

\ExplSyntaxOff

